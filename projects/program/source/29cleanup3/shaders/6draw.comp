#version 450 core
layout(local_size_x =   5, local_size_y =   5, local_size_z =   5) in;
layout(binding = 0)                    uniform sampler2D fieldSampler;
layout(binding = 1, rgba32f) writeonly uniform image2D   screentexture;


#define DRAW_TARGET_DYE               0x00
#define DRAW_TARGET_VELOCITY_PRESSURE 0x01
#define DRAW_TARGET_CURL              0x02
#define DRAW_TARGET_ABS_CURL          0x03
#define DRAW_TARGET_ERROR_VELOCITY    0x04
#define DRAW_TARGET_ERROR_PRESSURE    0x05
#define DRAW_TARGET_BOUNDARY          0x06
#define DRAW_TARGET_VELOCITY_X        0x07
#define DRAW_TARGET_VELOCITY_Y        0x08
#define DRAW_TARGET_PREESURE          0x09
#define DRAW_TARGET_CFL_CONTOUR       0x0A
#define DRAW_TARGET_MAX               0x0B


#define COLOUR_MAP_INFERNO 0x00
#define COLOUR_MAP_VIRDIS  0x01
#define COLOUR_MAP_FAST    0x02


uniform uint  ku_selectTextureDraw;
uniform uint  ku_selectColourMap;
uniform float ku_brightness;
uniform float ku_dt;
uniform vec2  ku_colormapMinmax;
uniform ivec2 ku_simdims;
uniform vec2  ku_simUnitCoord;
vec2 k_unitCoord = vec2(1) / vec2(ku_simdims);
vec2 k_rdxdy     = vec2(1) / ku_simUnitCoord;


/* 
    On Colourmaps:
    https://blog.habrador.com/2023/04/colormaps-overview-code-implementations-rainbow-virids.html
    See Also:
    https://www.kennethmoreland.com/color-advice/
*/
vec4 colorMapInferno(in float value);
vec4 colorMapVirdis(in float value);
vec4 colorMapFast(in float value);
float curl2D(
    in sampler2D tex,
    in ivec2     texel
);




void main()
{
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    vec2 norm_texcoord = vec2(texelCoord) / vec2(ku_simdims);
    

    vec4 write_value = texelFetch(fieldSampler, texelCoord, 0);
    bool  requireColourmap  = false;
    float intermediateFloat = 0.0f;
    switch(ku_selectTextureDraw) {
        case DRAW_TARGET_DYE:
        break;
        case DRAW_TARGET_VELOCITY_PRESSURE:
        write_value *= ku_brightness;
        break;
        case DRAW_TARGET_CURL:
        intermediateFloat = ku_brightness * curl2D(fieldSampler, texelCoord);
        requireColourmap = true;
        break;
        case DRAW_TARGET_ABS_CURL:
        intermediateFloat = ku_brightness * abs(curl2D(fieldSampler, texelCoord));
        requireColourmap = true;
        break;
        case DRAW_TARGET_ERROR_VELOCITY:
        write_value = vec4(ku_brightness * abs(write_value.xy), 0, 0);
        break;
        case DRAW_TARGET_ERROR_PRESSURE:
        intermediateFloat = write_value.z;
        float moreBlueWhenErrorHigh = 1.0f - clamp(ku_brightness * abs(intermediateFloat), 0, 1);
        write_value = mix(
            vec4(0, 0, 1, 0),
            vec4(1, 1, 1, 1),
            moreBlueWhenErrorHigh
        );
        requireColourmap = false;
        break;
        case DRAW_TARGET_BOUNDARY:
        break;
        case DRAW_TARGET_VELOCITY_X:
        intermediateFloat = ku_brightness * write_value.x;
        requireColourmap = true;
        break;
        case DRAW_TARGET_VELOCITY_Y:
        intermediateFloat = ku_brightness * write_value.y;
        requireColourmap = true;
        break;
        case DRAW_TARGET_PREESURE:
        intermediateFloat = ku_brightness * write_value.z;
        requireColourmap = true;
        break;
        case DRAW_TARGET_CFL_CONTOUR:
        intermediateFloat = ku_brightness * ku_dt;
        intermediateFloat *= (abs(write_value.x) / ku_simUnitCoord.x) + (abs(write_value.y) / ku_simUnitCoord.y);
        requireColourmap = true;
        break;
        case DRAW_TARGET_MAX:
        break;
        default:
        break;
    }


    if(requireColourmap) {
        switch(ku_selectColourMap) {
            case COLOUR_MAP_INFERNO:
            write_value = colorMapInferno(intermediateFloat);
            break;
            case COLOUR_MAP_VIRDIS:
            write_value = colorMapVirdis(intermediateFloat);
            break;
            case COLOUR_MAP_FAST:
            write_value = colorMapFast(intermediateFloat);
            break;
            default:
            write_value = vec4(0.424, 0.702, 0.851, 1.0f);
            break;
        }
    }


    imageStore(screentexture, texelCoord, write_value);
    return;
}




float curl2D(
    in sampler2D tex,
    in ivec2     texel
) {
    float samples[4] = float[4](
        texelFetch(tex, texel + ivec2(1, 0), 0).x,
        texelFetch(tex, texel - ivec2(1, 0), 0).x,
        texelFetch(tex, texel + ivec2(0, 1), 0).y,
        texelFetch(tex, texel - ivec2(0, 1), 0).y
    );
    
    vec2 temp = vec2(samples[2] - samples[3], samples[0] - samples[1]);
    temp *= k_rdxdy * 0.5f;
    
    return temp.x - temp.y;
}




