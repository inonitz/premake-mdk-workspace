vec4 colorMapInferno(in float value)
{
    if(isnan(value) || isinf(value)) {
        return vec4(0, 1, 0, 0);
    }
    if(value <= ku_colormapMinmax.x) {
        return inferno_colortable_256[0];
    }
    if(value >= ku_colormapMinmax.y) {
        return inferno_colortable_256[255];
    }


    bool found = false;
    int i = 0;
    while( !found && i < 255 ) {
        found = (inferno_colortable_256[i].x < value && value < inferno_colortable_256[i+1].x); 
        i += int(!found);
    }

    float lerpFactor = (value - inferno_colortable_256[i].x) 
        / 
        (inferno_colortable_256[i+1].x - inferno_colortable_256[i].x);


    return vec4(
        mix(
            inferno_colortable_256[i+1].yzw,
            inferno_colortable_256[i].yzw, 
            lerpFactor
        ), 0
    );
}


